{
  "$meta": {
    "name": "DieCast-QA design tokens",
    "version": "1.1.0",
    "status": "1.0.0 확정 (2026-11-16) + 1.1.0 추가 (2026-11-19: 관리도 σ 구역·히스토그램 막대·경고 띠 배경, 시안 v2 docs/design/preview_v2.html)",
    "consumers": [
      "app/web: tokens.css (CSS 변수, 밝은·어두운 테마)",
      "src/diecast_qa/viz/theme.py: 분석 그림 테마"
    ],
    "rules": [
      "색은 의미(semantic) 토큰으로만 쓴다. 컴포넌트가 primitive 값을 직접 쓰지 않는다",
      "상태 색(status)은 경보·관리한계 이탈에만 쓰고 항상 아이콘 + 라벨과 함께 쓴다",
      "범주 색(series)은 정해진 순서로만 배정하고 순위에 따라 바꾸지 않는다",
      "불량 유형 색은 모든 화면에서 같다 (defectType)"
    ],
    "validation": {
      "defectType 5색": "밝음·어두움 모두 CVD·정상 시각 인접 쌍 통과 (최악 ΔE 9.1 / 8.4). 밝은 테마 청록·노랑·분홍은 배경 대비 3:1 미만 → 직접 라벨 또는 표 보기 필수",
      "text": "밝음 primary 19.2, secondary 7.7, muted 3.5(축 눈금·보조 정보만) / 어두움 15.2, 9.7, 4.9",
      "accent": "버튼 #256abf 위 흰 글자 5.4:1 (두 테마 공통), 링크 글자 밝음 #256abf 5.3 / 어두움 #6da7ec",
      "badge": "경고 #d03b3b 흰 글자 4.8, 주의 #fab219 검정 글자 10.7, 위험 상 #ec835a 검정 글자 7.5"
    }
  },
