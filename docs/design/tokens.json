  "alarm": {
    "levels": {
      "critical": {
        "label": "경고",
        "color": "status.critical",
        "icon": "octagon-alert",
        "onColor": "#ffffff"
      },
      "warning": {
        "label": "주의",
        "color": "status.warning",
        "icon": "triangle-alert",
        "onColor": "#0b0b0b"
      },
      "info": {
        "label": "정보",
        "color": "text.secondary",
        "icon": "info",
        "onColor": "#ffffff"
      },
      "log": {
        "label": "기록",
        "color": "text.muted",
        "icon": "file-text",
        "onColor": "#ffffff"
      },
      "resolved": {
        "label": "해제",
        "color": "status.good",
        "icon": "circle-check",
        "onColor": "#ffffff"
      }
    },
    "order": [
      "critical",
      "warning",
      "info",
      "log",
      "resolved"
    ]
  },
  "risk": {
    "high": {
      "label": "상",
      "color": "status.serious",
      "icon": "arrow-up",
      "rule": "보정 확률 ≥ 1/비용 비율 (검사 대상)",
      "onColor": "#0b0b0b"
    },
    "medium": {
      "label": "중",
      "color": "text.secondary",
      "icon": "minus",
      "rule": "보정 확률 ≥ 평균 불량률",
      "onColor": "#ffffff"
    },
    "low": {
      "label": "하",
      "color": "text.muted",
      "icon": "arrow-down",
      "rule": "그 밖",
      "onColor": "#ffffff"
    }
  },
  "defectType": {
    "short_shot": {
      "label": "미성형",
      "series": 0
    },
    "exfoliation": {
      "label": "박리",
      "series": 1
    },
    "porosity": {
      "label": "기공",
      "series": 2
    },
    "deformation": {
      "label": "변형",
      "series": 3
    },
    "other": {
      "label": "기타",
      "series": 4
    },
    "normal": {
      "label": "정상",
      "color": "text.muted"
    }
  },
  "featureGroup": {
    "controllable": {
      "label": "조정 가능 변수",
      "note": "config.CONTROL_VARS"
    },
    "context": {
      "label": "시기·환경 변수",
      "note": "공장 온습도, shot 순번, 캐비티"
    }
  },
  "typography": {
    "family": {
      "sans": "'Pretendard Variable', Pretendard, -apple-system, 'Malgun Gothic', system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace"
    },
    "numeric": "tabular-nums",
    "weight": {
      "regular": 400,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "display": {
        "size": 32,
        "line": 40,
        "weight": 700,
        "use": "KPI 핵심 숫자"
      },
      "h1": {
        "size": 24,
        "line": 32,
        "weight": 700,
        "use": "화면 제목"
      },
      "h2": {
        "size": 18,
        "line": 26,
        "weight": 700,
        "use": "카드 제목"
      },
      "h3": {
        "size": 15,
        "line": 22,
        "weight": 600,
        "use": "소제목, 표 머리"
      },
      "body": {
        "size": 14,
        "line": 20,
        "weight": 400,
        "use": "본문, 표"
      },
      "small": {
        "size": 13,
        "line": 18,
        "weight": 400,
        "use": "보조 설명, 범례"
      },
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 400,
        "use": "축 라벨, 각주 (최소 크기)"
      }
    }
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "0.5": 2
  },
  "radius": {
    "sm": 4,
    "md": 8,
    "lg": 12,
    "full": 999
  },
  "shadow": {
    "none": "none",
    "popover": "0 4px 16px rgba(0,0,0,0.08)",
    "toast": "0 8px 24px rgba(0,0,0,0.14)",
    "modal": "0 16px 48px rgba(0,0,0,0.20)"
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 320
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "reduced": "prefers-reduced-motion이면 모든 전환 0ms, 재생 중 차트 점 추가에는 애니메이션을 쓰지 않는다"
  },
  "layout": {
    "breakpoint": {
      "md": 1024,
      "lg": 1280,
      "xl": 1440,
      "projector": 1920
    },
    "grid": {
      "columns": 12,
      "gutter": 16,
      "pagePadding": 24
    },
    "shell": {
      "topBar": 56,
      "sideNav": 72,
      "controlBar": 64,
      "alarmBanner": 48
    }
  },
  "z": {
    "base": 0,
    "sticky": 10,
    "dropdown": 100,
    "drawer": 900,
    "toast": 1000,
    "modal": 1100
  },
  "chart": {
    "line": {
      "width": 2,
      "referenceWidth": 1
    },
    "marker": {
      "size": 8,
      "ring": 2
    },
    "bar": {
      "radius": 4,
      "gap": 2
    },
    "grid": {
      "width": 1,
      "style": "hairline, 값 축에만"
    },
    "outOfControl": {
      "color": "status.critical",
      "shape": "diamond",
      "label": "관리한계 이탈"
    },
    "tooltip": {
      "crosshair": true,
      "delayMs": 0
    },
    "maxSeries": {
      "line": 8,
      "scatter": 3
    }
  }
}
