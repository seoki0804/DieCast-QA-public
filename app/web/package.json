{
  "name": "diecast-qa-web",
  "version": "1.0.0",
  "private": true,
  "description": "DieCast-QA 재생 시뮬레이션 대시보드 (Next.js)",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "next dev -p 3000",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --test src/lib/",
    "e2e": "node --test --test-concurrency=1 e2e/replay.e2e.mjs",
    "shots": "node scripts/capture-report-shots.mjs"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "next": "16.4.6",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "type": "module",
  "devDependencies": {
    "playwright-core": "1.65.1"
  }
}
